---
import { process } from '../data/site';
---

<ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
  {
    process.map((p) => (
      <li class="border-t border-line pt-5">
        <span class="font-display text-4xl font-semibold leading-none text-copper">
          {p.step}
        </span>
        <h3 class="mt-3 text-[17px] font-semibold text-ink">{p.title}</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-steel">{p.text}</p>
      </li>
    ))
  }
</ol>
