---
import { site } from '../data/site';
import { Phone } from '@lucide/astro';
---

<section class="wrap py-20 sm:py-24">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="label-rule">Lokasjon</p>
      <h2 class="h-section mt-3">Nydalen, Oslo</h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-steel">
        Verkstedet ligger i Nydalen, med parkering på egen tomt. Lever bilen om
        morgenen — de fleste behandlinger er ferdige samme dag.
      </p>

      <dl class="mt-10 max-w-md">
        <div class="grid grid-cols-[130px_1fr] gap-4 border-t border-line py-3.5 text-sm">
          <dt class="text-steel">Adresse</dt>
          <dd class="font-medium text-ink">
            {site.address.street}, {site.address.postal}
          </dd>
        </div>
        <div class="grid grid-cols-[130px_1fr] gap-4 border-t border-line py-3.5 text-sm">
          <dt class="text-steel">Åpningstider</dt>
          <dd class="space-y-1 text-steel">
            {site.hours.map((h) => (
              <p class="tabular">{h.label}: {h.value}</p>
            ))}
          </dd>
        </div>
        <div class="grid grid-cols-[130px_1fr] gap-4 border-t border-line py-3.5 text-sm">
          <dt class="text-steel">Parkering</dt>
          <dd class="text-steel">{site.parking}</dd>
        </div>
        <div class="grid grid-cols-[130px_1fr] gap-4 border-t border-line py-3.5 text-sm">
          <dt class="text-steel">Telefon</dt>
          <dd>
            <a href={site.phone.href} class="inline-flex items-center gap-2 font-medium text-ink transition-colors hover:text-copper">
              <Phone class="h-4 w-4 text-copper" aria-hidden="true" />
              {site.phone.display}
            </a>
          </dd>
        </div>
        <p class="border-b border-line" aria-hidden="true"></p>
      </dl>
    </div>

    <div class="flex flex-col">
      <div class="flex flex-1 flex-col justify-between bg-ink p-8 sm:p-10">
        <div>
          <p class="label-rule label-rule--dark">Verkstedet</p>
          <p class="mt-7 font-display text-3xl font-semibold leading-tight text-paper sm:text-4xl">
            {site.address.street}
          </p>
          <p class="mt-1 text-lg text-paper/70">{site.address.postal}</p>
        </div>
        <div class="mt-10 grid gap-3 sm:grid-cols-2">
          <a
            href={site.maps.google}
            target="_blank"
            rel="noopener"
            class="btn-primary-dark"
          >
            Åpne i Google Maps
          </a>
          <a
            href={site.maps.apple}
            target="_blank"
            rel="noopener"
            class="btn-secondary-dark"
          >
            Apple Kart
          </a>
        </div>
      </div>
      <p class="mt-3 text-xs text-steel">
        Kartlenkene er klargjort for ekte kart-integrasjon i en senere versjon.
      </p>
    </div>
  </div>
</section>
