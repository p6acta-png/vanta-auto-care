---
import { Image } from 'astro:assets';
import { images } from '../data/images';
---

<!-- Før/etter — sentralt visuelt bevis.
     Før-siden er simulert (CSS-filter) og tydelig merket som eksempel.
     Mus, touch og tastatur (range-input). -->
<figure class="beforeafter relative aspect-[4/3] w-full select-none overflow-hidden bg-ink sm:aspect-[16/9]">
  <Image
    src={images.paint}
    alt="Polert mørk bil — etter"
    widths={[480, 800, 1280, 1600]}
    sizes="(max-width: 640px) 100vw, 1152px"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />

  <div class="ba-before absolute inset-0" aria-hidden="true">
    <Image
      src={images.paint}
      alt=""
      widths={[480, 800, 1280, 1600]}
      sizes="(max-width: 640px) 100vw, 1152px"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
    />
  </div>

  <figcaption class="ba-label pointer-events-none absolute left-4 top-4 z-10 bg-ink/75 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-paper">
    Før
  </figcaption>
  <figcaption class="ba-label pointer-events-none absolute right-4 top-4 z-10 bg-copper px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-paper">
    Etter
  </figcaption>

  <div class="ba-divider pointer-events-none absolute bottom-0 top-0 z-10 w-px bg-paper" aria-hidden="true">
    <span
      class="absolute left-1/2 top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-paper/70 bg-ink/80 text-paper"
    >
      <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M6 4 2 8l4 4M10 4l4 4-4 4" />
      </svg>
    </span>
  </div>

  <input
    type="range"
    min="0"
    max="100"
    value="50"
    class="ba-input absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
    aria-label="Sammenlign før og etter behandling"
  />
</figure>
<p class="mt-4 text-xs leading-relaxed text-steel">
  Eksempel på resultat — lakkrens og polering. Før-bildet er simulert for å
  illustrere forskjellen; dette er ikke en ekte kundebil.
</p>

<style>
  .beforeafter {
    --pos: 50%;
  }
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    filter: saturate(0.55) brightness(0.78) contrast(0.92) sepia(0.22);
  }
  .ba-divider {
    left: var(--pos);
  }
  .ba-input:focus-visible ~ .ba-divider {
    outline: 2px solid var(--color-copper);
    outline-offset: -2px;
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('.ba-input');
  const root = document.querySelector<HTMLElement>('.beforeafter');
  if (input && root) {
    const update = () => {
      root.style.setProperty('--pos', input.value + '%');
    };
    input.addEventListener('input', update);
    update();
  }
</script>
