---
import { withBase } from '../utils/links';
import { site } from '../data/site';
import { type Locale } from '../i18n';
import { getContent } from '../i18n/content';
import { switchLocale, toEnPath, toLocalePath } from '../i18n';
import { Menu, X, Phone } from '@lucide/astro';

interface Props {
  locale: Locale;
  home?: boolean;
}

const { locale, home = false } = Astro.props;
const t = getContent(locale);
const isHome = home;
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const rawPath = (Astro.url.pathname.replace(/\/+$/, '') || '/').replace(baseNoSlash, '') || '/';
const enPath = toEnPath(rawPath);
const bookHref = toLocalePath(locale, '/book');
const quoteHref = toLocalePath(locale, '/book') + '#quote';
const homeHref = locale === 'no' ? '/no/' : '/';

const navLocal = t.nav.map((n) => ({ ...n, href: toLocalePath(locale, n.href) }));
---

<header id="site-header" data-solid={isHome ? 'false' : 'true'}>
  <div class="wrap flex h-16 items-center justify-between gap-5">
    <a href={withBase(homeHref)} class="flex flex-col leading-none" aria-label="{site.name} — home">
      <span class="font-display text-[23px] font-semibold tracking-[0.09em]">
        VANTA<span class="text-copper">.</span>
      </span>
      <span class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.32em] opacity-60">
        Auto&nbsp;Care
      </span>
    </a>

    <nav class="hidden items-center gap-7 xl:flex" aria-label="Main">
      {
        navLocal.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'text-[13px] font-medium transition-colors hover:text-copper',
              !isHome && enPath.startsWith(item.href) ? 'text-copper' : '',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-5 md:flex">
      <div class="flex items-baseline gap-1 text-[12px] font-semibold uppercase tracking-[0.14em]">
        <a
          href={withBase(switchLocale(rawPath, 'en'))}
          class:list={['transition-colors hover:text-copper', locale === 'en' ? 'text-copper' : 'opacity-60']}
          aria-label="English"
        >
          EN
        </a>
        <span class="opacity-30" aria-hidden="true">/</span>
        <a
          href={withBase(switchLocale(rawPath, 'no'))}
          class:list={['transition-colors hover:text-copper', locale === 'no' ? 'text-copper' : 'opacity-60']}
          aria-label="Norsk"
        >
          NO
        </a>
      </div>
      <a
        href={site.phone.href}
        class="hidden items-center gap-1.5 text-[13px] font-medium opacity-80 transition-colors hover:text-copper lg:flex"
      >
        <Phone class="h-3.5 w-3.5" aria-hidden="true" />
        {site.phone.display}
      </a>
      <a href={withBase(bookHref)} class="btn btn-cta !px-5 !py-2.5">
        {t.ui.book}
      </a>
    </div>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.ui.menuOpen}
    >
      <Menu id="icon-open" class="h-6 w-6" aria-hidden="true" />
      <X id="icon-close" class="hidden h-6 w-6" aria-hidden="true" />
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden overflow-y-auto bg-ink text-paper opacity-0 transition-opacity duration-200 md:hidden"
  aria-hidden="true"
>
  <div class="wrap flex min-h-full flex-col pt-24">
    <div class="flex items-baseline gap-1 border-b border-paper/15 pb-5 text-[13px] font-semibold uppercase tracking-[0.14em]">
      <a
        href={withBase(switchLocale(rawPath, 'en'))}
        class:list={['transition-colors hover:text-copper', locale === 'en' ? 'text-copper' : 'opacity-60']}
        aria-label="English"
      >
        EN
      </a>
      <span class="opacity-30" aria-hidden="true">/</span>
      <a
        href={withBase(switchLocale(rawPath, 'no'))}
        class:list={['transition-colors hover:text-copper', locale === 'no' ? 'text-copper' : 'opacity-60']}
        aria-label="Norsk"
      >
        NO
      </a>
    </div>

    <nav class="flex flex-col border-b border-paper/15 pb-4" aria-label="Mobile">
      {
        navLocal.map((item) => (
          <a
            href={withBase(item.href)}
            class="border-b border-paper/10 py-3.5 font-display text-3xl font-medium tracking-wide text-paper transition-colors hover:text-copper"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-3 py-7">
      <a href={withBase(bookHref)} class="btn-primary-dark w-full">{t.ui.book}</a>
      <a href={withBase(quoteHref)} class="btn-secondary-dark w-full">{t.ui.quote}</a>
    </div>

    <div class="mt-auto space-y-4 border-t border-paper/15 py-7 text-sm text-paper/80">
      <a href={site.phone.href} class="flex items-center gap-2 font-medium text-paper hover:text-copper">
        <Phone class="h-4 w-4" aria-hidden="true" />
        {site.phone.display}
      </a>
      <p>
        {site.address.street}, {site.address.postal}
        <br />
        {t.hours[0].label}: {t.hours[0].value}
      </p>
      <p class="text-xs text-paper/50">{t.ui.demo}</p>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const isHome = header?.dataset.solid === 'false';
  if (header) {
    const update = () => {
      if (window.scrollY > 30) {
        header.dataset.solid = 'true';
      } else if (isHome) {
        header.dataset.solid = 'false';
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const openLabel = toggle?.getAttribute('aria-label') ?? 'Open menu';

  if (toggle && panel) {
    const open = () => {
      panel.classList.remove('hidden');
      requestAnimationFrame(() => {
        panel.classList.remove('opacity-0');
        panel.setAttribute('aria-hidden', 'false');
      });
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', openLabel === 'Åpne meny' ? 'Lukk meny' : 'Close menu');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      (panel.querySelector('a, button') as HTMLElement | null)?.focus();
    };

    const close = () => {
      panel.classList.add('opacity-0');
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', openLabel === 'Lukk meny' ? 'Åpne meny' : 'Open menu');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
      setTimeout(() => panel.classList.add('hidden'), 220);
      toggle.focus();
    };

    toggle.addEventListener('click', () => {
      if (panel.classList.contains('hidden')) open();
      else close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) close();
    });

    panel.querySelectorAll('a, button').forEach((el) =>
      el.addEventListener('click', close)
    );
  }
</script>
