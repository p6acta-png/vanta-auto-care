---
import { nav, site } from '../data/site';
import { Menu, X, Phone } from '@lucide/astro';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pagePath = Astro.url.pathname.replace(/\/+$/, '').replace(baseNoSlash, '') || '/';
const isHome = home;
---

<header id="site-header" data-solid={isHome ? 'false' : 'true'}>
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex flex-col leading-none" aria-label="{site.name} — hjem">
      <span class="font-display text-[23px] font-semibold tracking-[0.09em]">
        VANTA<span class="text-copper">.</span>
      </span>
      <span class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.32em] opacity-60">
        Auto&nbsp;Care
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Hovedmeny">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-[13px] font-medium transition-colors hover:text-copper',
              !isHome && pagePath.startsWith(item.href) ? 'text-copper' : '',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-6 md:flex">
      <a
        href={site.phone.href}
        class="flex items-center gap-1.5 text-[13px] font-medium opacity-80 transition-colors hover:text-copper"
      >
        <Phone class="h-3.5 w-3.5" aria-hidden="true" />
        {site.phone.display}
      </a>
      <a href="/bestill-time" class="btn btn-cta !px-5 !py-2.5">
        Bestill time
      </a>
    </div>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Åpne meny"
    >
      <Menu id="icon-open" class="h-6 w-6" aria-hidden="true" />
      <X id="icon-close" class="hidden h-6 w-6" aria-hidden="true" />
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden overflow-y-auto bg-ink text-paper opacity-0 transition-opacity duration-200 md:hidden"
  aria-hidden="true"
>
  <div class="wrap flex min-h-full flex-col pt-24">
    <nav class="flex flex-col border-b border-paper/15 pb-6" aria-label="Meny">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-paper/10 py-4 font-display text-3xl font-medium tracking-wide text-paper transition-colors hover:text-copper"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-3 py-8">
      <a href="/bestill-time" class="btn-primary-dark w-full">Bestill time</a>
      <a href="/bestill-time#overslag" class="btn-secondary-dark w-full">
        Få et prisoverslag
      </a>
    </div>

    <div class="mt-auto space-y-4 border-t border-paper/15 py-8 text-sm text-paper/80">
      <a href={site.phone.href} class="flex items-center gap-2 font-medium text-paper hover:text-copper">
        <Phone class="h-4 w-4" aria-hidden="true" />
        {site.phone.display}
      </a>
      <p>
        {site.address.street}, {site.address.postal}
        <br />
        Man–fre 08.00–17.00 · Lør 10.00–14.00
      </p>
      <p class="text-xs text-paper/50">{site.demoNotice}</p>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const isHome = header?.dataset.solid === 'false';
  if (header) {
    const update = () => {
      if (window.scrollY > 30) {
        header.dataset.solid = 'true';
      } else if (isHome) {
        header.dataset.solid = 'false';
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (toggle && panel) {
    const open = () => {
      panel.classList.remove('hidden');
      requestAnimationFrame(() => {
        panel.classList.remove('opacity-0');
        panel.setAttribute('aria-hidden', 'false');
      });
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Lukk meny');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      (panel.querySelector('a, button') as HTMLElement | null)?.focus();
    };

    const close = () => {
      panel.classList.add('opacity-0');
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Åpne meny');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
      setTimeout(() => panel.classList.add('hidden'), 220);
      toggle.focus();
    };

    toggle.addEventListener('click', () => {
      if (panel.classList.contains('hidden')) open();
      else close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) close();
    });

    panel.querySelectorAll('a, button').forEach((el) =>
      el.addEventListener('click', close)
    );
  }
</script>
