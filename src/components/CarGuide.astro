---
import { withBase } from '../utils/links';
import { site } from '../data/site';
import { type Locale , toLocalePath } from '../i18n';
import { getContent, serviceBySlug } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const g = t.guide;
---

<!-- Veiledning: «What do you want to achieve?» -->
<div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
  <div role="group" aria-label={g.title}>
    {
      g.options.map((o) => (
        <button
          type="button"
          data-guide={o.id}
          data-target={o.target ?? ''}
          data-note={o.note}
          aria-pressed={o.id === 'refresh' ? 'true' : 'false'}
          class="guide-opt grid w-full grid-cols-1 items-baseline gap-1 border-t border-line py-3.5 text-left transition-colors hover:bg-paper-2/60"
        >
          <span class="block font-medium text-ink">{o.label}</span>
          <span class="block text-sm text-steel">{o.desc}</span>
        </button>
      ))
    }
    <p class="border-b border-line" aria-hidden="true"></p>
  </div>

  <div class="guide-panel-wrap bg-concrete p-7 sm:p-9" aria-live="polite">
    {
      g.options.map((o, i) => {
        const s = o.target ? serviceBySlug(locale, o.target) : null;
        return (
          <div data-panel={o.id} class:list={['guide-panel', i !== 0 && 'hidden']}>
            {s ? (
              <>
                <p class="micro text-copper-deep">{g.recommended}</p>
                <h3 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink">
                  {s.name}
                </h3>
                <p class="mt-3 text-[15px] leading-relaxed text-steel">{s.short}</p>
                <dl class="mt-6 max-w-sm">
                  <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-2.5 text-sm">
                    <dt class="micro">{g.fromPrice}</dt>
                    <dd class="font-display text-xl tabular text-ink">{s.priceFrom}</dd>
                  </div>
                  <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-2.5 text-sm">
                    <dt class="micro">{g.time}</dt>
                    <dd class="text-ink">{s.duration}</dd>
                  </div>
                  <p class="border-b border-line" aria-hidden="true"></p>
                </dl>
                <p class="mt-4 text-xs leading-relaxed text-steel">{o.note}</p>
                <div class="mt-6 flex flex-wrap gap-3">
                  {s.booking === 'direct' ? (
                    <a href={withBase(toLocalePath(locale, '/book') + `?service=${s.slug}`)} class="btn-primary">
                      {t.ui.book}
                    </a>
                  ) : (
                    <a href={withBase(toLocalePath(locale, '/book') + '#quote')} class="btn-primary">
                      {t.ui.quote}
                    </a>
                  )}
                  <a
                    href={withBase(toLocalePath(locale, '/services') + `#${s.slug}`)}
                    class="btn-secondary"
                  >
                    {g.more}
                  </a>
                </div>
              </>
            ) : (
              <>
                <p class="micro text-copper-deep">{g.recommended}</p>
                <h3 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink">
                  {g.unsureTitle}
                </h3>
                <p class="mt-3 text-[15px] leading-relaxed text-steel">{g.unsureText}</p>
                <p class="mt-4 text-xs leading-relaxed text-steel">{g.freeNote}</p>
                <div class="mt-6 flex flex-wrap gap-3">
                  <a href={withBase(toLocalePath(locale, '/book') + '#quote')} class="btn-primary">
                    {t.ui.quote}
                  </a>
                  <a href={site.phone.href} class="btn-secondary">
                    {site.phone.display}
                  </a>
                </div>
              </>
            )}
          </div>
        );
      })
    }
  </div>
</div>

<script>
  const opts = document.querySelectorAll<HTMLButtonElement>('.guide-opt');
  const panels = document.querySelectorAll<HTMLElement>('.guide-panel');
  const setActive = (id: string) => {
    opts.forEach((b) => {
      b.setAttribute('aria-pressed', b.dataset.guide === id ? 'true' : 'false');
      b.classList.toggle('is-active', b.dataset.guide === id);
    });
    panels.forEach((p) => {
      p.classList.toggle('hidden', p.dataset.panel !== id);
    });
  };
  opts.forEach((b) => {
    b.addEventListener('click', () => setActive(b.dataset.guide ?? ''));
  });
</script>
