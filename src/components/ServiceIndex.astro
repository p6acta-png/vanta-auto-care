---
import type { Service } from '../data/site';

interface Props {
  items: Service[];
}

const { items } = Astro.props;
---

<!-- Tjenesteindeks: høy informasjonstetthet, pris synlig med én gang -->
<div>
  {
    items.map((s) => (
      <a
        href={`/tjenester#${s.slug}`}
        class="group grid grid-cols-1 items-baseline gap-x-8 gap-y-1.5 border-t border-line py-5 transition-colors sm:grid-cols-[1fr_auto]"
      >
        <div class="min-w-0">
          <h3 class="font-display text-[1.4rem] font-semibold leading-tight text-ink transition-colors group-hover:text-copper">
            {s.name}
          </h3>
          <p class="mt-1 max-w-xl text-sm leading-relaxed text-steel">{s.short}</p>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5 sm:flex-col sm:items-end">
          <span class="tabular text-[17px] font-semibold text-ink">{s.priceFrom}</span>
          <span class="text-xs text-steel">
            {s.duration}
            <span aria-hidden="true"> · </span>
            {s.booking === 'direct' ? 'Bestill direkte' : 'Prisoverslag'}
          </span>
        </div>
      </a>
    ))
  }
  <p class="border-b border-line" aria-hidden="true"></p>
</div>
