---
import { type Locale } from '../i18n';
import { getContent } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const f = t.form;
const times = ['08.00', '09.30', '11.00', '12.30', '14.00', '15.30'];
const direct = t.services.filter((s) => s.booking === 'direct');
const quote = t.services.filter((s) => s.booking === 'quote');
const quoteSlugs = quote.map((s) => s.slug);
---

<div id="quote" class="scroll-mt-24 border border-line bg-paper">
  <form
    id="booking-form"
    novalidate
    data-quote-slugs={JSON.stringify(quoteSlugs)}
    data-submit-quote={f.submitQuote}
    data-hint-quote={f.serviceHintQuote}
    data-success-direct={f.successDirect}
    data-success-quote={f.successQuote}
    class="p-6 sm:p-8"
  >
    <div class="field">
      <label for="service">{f.service}</label>
      <select id="service" name="service" required>
        <optgroup label={f.optDirect}>
          {direct.map((s) => (
            <option value={s.slug}>{s.name}</option>
          ))}
        </optgroup>
        <optgroup label={f.optQuote}>
          {quote.map((s) => (
            <option value={s.slug}>{s.name}</option>
          ))}
        </optgroup>
      </select>
      <p id="service-hint" class="hint">{f.serviceHintDirect}</p>
    </div>

    <fieldset class="mode-direct">
      <legend class="field-legend">{f.name}</legend>
      <div class="grid gap-x-4 sm:grid-cols-2">
        <div class="field">
          <label for="navn">{f.name}</label>
          <input id="navn" name="navn" type="text" autocomplete="name" placeholder={f.namePh} />
          <p class="error" data-error-for="navn">{f.nameErr}</p>
        </div>
        <div class="field">
          <label for="telefon">{f.phone}</label>
          <input id="telefon" name="telefon" type="tel" autocomplete="tel" placeholder={f.phonePh} />
          <p class="error" data-error-for="telefon">{f.phoneErr}</p>
        </div>
      </div>
      <div class="field">
        <label for="epost">{f.email}</label>
        <input id="epost" name="epost" type="email" autocomplete="email" placeholder={f.emailPh} />
        <p class="error" data-error-for="epost">{f.emailErr}</p>
      </div>
    </fieldset>

    <fieldset class="mode-direct">
      <legend class="field-legend">{f.car}</legend>
      <div class="field">
        <label for="merke">{f.car}</label>
        <input id="merke" name="merke" type="text" placeholder={f.carPh} />
        <p class="error" data-error-for="merke">{f.carErr}</p>
      </div>
    </fieldset>

    <fieldset id="fs-direct" class="mode-direct">
      <legend class="field-legend">{f.time}</legend>
      <div class="grid gap-x-4 sm:grid-cols-2">
        <div class="field">
          <label for="dato">{f.date}</label>
          <input id="dato" name="dato" type="date" />
          <p class="error" data-error-for="dato">{f.dateErr}</p>
        </div>
        <div class="field">
          <label for="tid">{f.time}</label>
          <select id="tid" name="tid">
            <option value="">{f.timePh}</option>
            {times.map((t) => <option value={t}>{t}</option>)}
          </select>
          <p class="error" data-error-for="tid">{f.timeErr}</p>
        </div>
      </div>
      <p class="hint">{f.timeHint}</p>
    </fieldset>

    <fieldset id="fs-quote" class="mode-quote hidden">
      <legend class="field-legend">{f.car}</legend>
      <div class="grid gap-x-4 sm:grid-cols-3">
        <div class="field">
          <label for="aar">{f.year}</label>
          <input id="aar" name="aar" type="text" inputmode="numeric" placeholder={f.yearPh} />
        </div>
        <div class="field sm:col-span-2">
          <label for="regnr">{f.reg}</label>
          <input id="regnr" name="regnr" type="text" placeholder={f.regPh} />
        </div>
      </div>
      <div class="field">
        <label for="melding">{f.message}</label>
        <textarea
          id="melding"
          name="melding"
          rows="4"
          placeholder={f.messagePh}
        ></textarea>
      </div>
      <div class="field">
        <label for="bilde">{f.photos}</label>
        <input id="bilde" name="bilde" type="file" accept="image/*" />
        <p class="hint">{f.photosHint}</p>
      </div>
    </fieldset>

    <button type="submit" id="submit-btn" class="btn-primary w-full sm:w-auto">
      {f.submitDirect}
    </button>
    <p class="mt-4 text-xs leading-relaxed text-steel">
      {t.ui.demo} {f.demoNote}
    </p>
  </form>

  <!-- Bekreftelse -->
  <div id="form-success" class="hidden p-6 sm:p-8" role="status" aria-live="polite">
    <p class="font-display text-3xl font-semibold text-ink">
      {f.successTitle}<span id="success-name"></span>!
    </p>
    <p id="success-text" class="mt-3 max-w-md text-[15px] leading-relaxed text-steel"></p>
    <ol class="mt-6 max-w-md space-y-3 text-sm text-steel">
      <li class="flex gap-3">
        <span class="font-display text-lg font-semibold text-copper">1</span>
        {f.successStep1}
      </li>
      <li class="flex gap-3">
        <span class="font-display text-lg font-semibold text-copper">2</span>
        {f.successStep2}
      </li>
      <li class="flex gap-3">
        <span class="font-display text-lg font-semibold text-copper">3</span>
        {f.successStep3}
      </li>
    </ol>
    <p class="mt-6 text-xs text-steel/70">{f.successDemo} {t.ui.demo}</p>
    <button type="button" id="reset-btn" class="btn-secondary mt-6">{f.reset}</button>
  </div>
</div>

<style>
  .field {
    margin-bottom: 1.1rem;
  }
  .field legend.field-legend {
    display: block;
    width: 100%;
    margin-bottom: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .field :is(input[type='text'], input[type='tel'], input[type='email'], input[type='date'], select, textarea) {
    width: 100%;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    padding: 0.625rem 0.875rem;
    font-size: 15px;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }
  .field :is(input, select, textarea)::placeholder {
    color: color-mix(in srgb, var(--color-steel) 60%, transparent);
  }
  .field :is(input, select, textarea):focus {
    border-color: var(--color-copper);
    outline: none;
  }
  .field .hint {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-steel);
  }
  .field .error {
    display: none;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-error);
  }
  .field.has-error :is(input, select, textarea) {
    border-color: var(--color-error);
  }
  .field.has-error .error {
    display: block;
  }
</style>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  if (!form) throw new Error('booking form missing');

  const quoteSlugs = JSON.parse(form.dataset.quoteSlugs ?? '[]') as string[];
  const service = document.getElementById('service') as HTMLSelectElement;
  const serviceHint = document.getElementById('service-hint') as HTMLParagraphElement;
  const fsDirect = document.getElementById('fs-direct') as HTMLFieldSetElement;
  const fsQuote = document.getElementById('fs-quote') as HTMLFieldSetElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('form-success') as HTMLDivElement;
  const successName = document.getElementById('success-name') as HTMLSpanElement;
  const successText = document.getElementById('success-text') as HTMLParagraphElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const dato = document.getElementById('dato') as HTMLInputElement;

  const submitDirect = submitBtn.textContent ?? '';
  const hintDirect = serviceHint.textContent ?? '';
  const isQuote = () => quoteSlugs.includes(service.value);

  const updateMode = () => {
    const quoteMode = isQuote();
    fsDirect.classList.toggle('hidden', quoteMode);
    fsQuote.classList.toggle('hidden', !quoteMode);
    (fsDirect.querySelectorAll('input, select')).forEach((el) => {
      (el as HTMLInputElement).required = !quoteMode;
    });
    (fsQuote.querySelectorAll('input, textarea')).forEach((el) => {
      if (!['aar', 'regnr', 'bilde'].includes((el as HTMLInputElement).id)) {
        (el as HTMLInputElement).required = quoteMode;
      }
    });
    submitBtn.textContent = quoteMode ? form.dataset.submitQuote ?? '' : submitDirect;
    serviceHint.textContent = quoteMode ? form.dataset.hintQuote ?? '' : hintDirect;
  };

  const setError = (id: string, show: boolean) => {
    const field = document.getElementById(id)?.closest('.field');
    field?.classList.toggle('has-error', show);
    const input = document.getElementById(id) as HTMLInputElement | null;
    if (input) input.setAttribute('aria-invalid', String(show));
  };

  const validators: Record<string, () => boolean> = {
    navn: () => (document.getElementById('navn') as HTMLInputElement).value.trim().length >= 2,
    telefon: () => /^[+0-9][0-9\s\-]{7,}$/.test((document.getElementById('telefon') as HTMLInputElement).value.trim()),
    epost: () => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((document.getElementById('epost') as HTMLInputElement).value.trim()),
    merke: () => (document.getElementById('merke') as HTMLInputElement).value.trim().length >= 2,
    dato: () => (document.getElementById('dato') as HTMLInputElement).value !== '',
    tid: () => (document.getElementById('tid') as HTMLSelectElement).value !== '',
  };

  const validate = (): boolean => {
    let firstInvalid: string | null = null;
    let allOk = true;
    for (const id of Object.keys(validators)) {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (!el || el.disabled || el.closest('.hidden')) continue;
      const ok = validators[id]();
      setError(id, !ok);
      if (!ok && !firstInvalid) firstInvalid = id;
      if (!ok) allOk = false;
    }
    if (firstInvalid) {
      (document.getElementById(firstInvalid) as HTMLElement).focus();
    }
    return allOk;
  };

  service.addEventListener('change', updateMode);
  form.addEventListener('input', (e) => {
    const id = (e.target as HTMLElement).id;
    if (id && validators[id]) setError(id, !validators[id]());
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validate()) return;
    const navn = (document.getElementById('navn') as HTMLInputElement).value.trim();
    const chosen = service.selectedOptions[0]?.textContent ?? '';
    successName.textContent = navn.split(' ')[0];
    const prefix = isQuote() ? form.dataset.successQuote ?? '' : form.dataset.successDirect ?? '';
    successText.textContent = prefix + chosen.toLowerCase();
    form.classList.add('hidden');
    success.classList.remove('hidden');
    success.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  resetBtn.addEventListener('click', () => {
    form.reset();
    updateMode();
    form.classList.remove('hidden');
    success.classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const today = new Date();
  dato.min = today.toISOString().split('T')[0];

  const params = new URLSearchParams(window.location.search);
  const preselect = params.get('service');
  if (preselect && Array.from(service.options).some((o) => o.value === preselect)) {
    service.value = preselect;
  } else if (window.location.hash === '#quote') {
    const firstQuote = quoteSlugs[0];
    if (firstQuote) service.value = firstQuote;
  }
  updateMode();
</script>
