---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { withBase } from '../utils/links';
import { images } from '../data/images';
import { site } from '../data/site';
import { type Locale, toLocalePath } from '../i18n';
import { getContent } from '../i18n/content';
import { Phone } from '@lucide/astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const ap = t.aboutPage;
---

<Base locale={locale} page="about" enPath="/about">
  <section class="wrap py-14 sm:py-20">
    <p class="micro">{ap.kicker}</p>
    <h1 class="h-display mt-4 max-w-3xl">{ap.title}</h1>
    <div class="mt-10 grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div class="max-w-2xl space-y-5 text-[15px] leading-relaxed text-steel">
        {
          ap.paragraphs.map((p) => (
            <p>{p}</p>
          ))
        }
        <p class="text-xs text-steel/70">{t.pricing.demoNote}</p>
      </div>
      <figure>
        <div class="overflow-hidden">
          <Image
            src={images.garage}
            widths={[640, 1024]}
            sizes="(max-width: 1024px) 100vw, 45vw"
            alt={t.alt.garage}
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-3 text-[11px] uppercase tracking-[0.16em] text-steel">
          {ap.imageCaption}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ PRINSIPPER ============ -->
  <section class="border-t border-line bg-concrete">
    <div class="wrap py-14 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-20">
        <div>
          <p class="micro">{ap.principlesKicker}</p>
          <h2 class="display-xl mt-3">{ap.principlesTitle}</h2>
        </div>
        <div>
          {
            ap.principles.map((p) => (
              <div class="grid gap-1 border-t border-line py-4 sm:grid-cols-[220px_1fr] sm:gap-8">
                <h3 class="text-base font-semibold text-ink">{p.title}</h3>
                <p class="text-sm leading-relaxed text-steel">{p.text}</p>
              </div>
            ))
          }
          <p class="border-b border-line" aria-hidden="true"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BESØK ============ -->
  <section class="wrap py-16 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="micro">{ap.visitKicker}</p>
        <h2 class="display-xl mt-3">{ap.visitTitle}</h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-steel">{ap.visitText}</p>
        <dl class="mt-9 max-w-md">
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">{t.hero.spec[0].label}</dt>
            <dd class="font-medium">{t.hero.spec[0].value}</dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">{t.hero.spec[2].label}</dt>
            <dd>
              <a href={site.phone.href} class="inline-flex items-center gap-2 font-medium transition-colors hover:text-copper">
                <Phone class="h-4 w-4 text-copper" aria-hidden="true" />
                {site.phone.display}
              </a>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">Email</dt>
            <dd>
              <a href={`mailto:${site.email}`} class="font-medium transition-colors hover:text-copper">
                {site.email}
              </a>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">{t.hero.spec[1].label}</dt>
            <dd class="tabular">{t.hero.spec[1].value}</dd>
          </div>
          <p class="border-b border-line" aria-hidden="true"></p>
        </dl>
      </div>
      <div class="flex flex-col justify-center">
        <h3 class="text-xl font-semibold text-ink">{t.ui.quote}</h3>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-steel">{t.finalCta.text}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={withBase(toLocalePath(locale, '/book'))} class="btn-primary">{t.ui.book}</a>
          <a href={withBase(toLocalePath(locale, '/book') + '#quote')} class="btn-secondary">{t.ui.quote}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
