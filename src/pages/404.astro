---
import Base from '../layouts/Base.astro';
import { withBase } from '../utils/links';
import { getContent } from '../i18n/content';
import { toLocalePath } from '../i18n';
import type { Locale } from '../i18n';

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const rawPath = (Astro.url.pathname.replace(/\/+$/, '') || '/').replace(baseNoSlash, '') || '/';
const locale: Locale = rawPath === '/no' || rawPath.startsWith('/no/') ? 'no' : 'en';
const t = getContent(locale);
---

<Base locale={locale} page="home" enPath="/">
  <section class="wrap flex min-h-[55vh] flex-col justify-center py-24">
    <p class="micro">{t.notFound.kicker}</p>
    <h1 class="h-display mt-4 max-w-2xl">{t.notFound.title}</h1>
    <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-steel">{t.notFound.text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase(toLocalePath(locale, '/'))} class="btn-primary">{t.notFound.home}</a>
      <a href={withBase(toLocalePath(locale, '/book'))} class="btn-secondary">{t.notFound.book}</a>
    </div>
  </section>
</Base>
