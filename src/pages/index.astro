---
import { withBase } from '../utils/links';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { images, imageAlt } from '../data/images';
import { site, services, sizeClasses, sizePrices, priceDisclaimer } from '../data/site';
import ServiceIndex from '../components/ServiceIndex.astro';
import CarGuide from '../components/CarGuide.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import MapsBlock from '../components/MapsBlock.astro';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AutoWash',
  name: site.name,
  url: site.url,
  telephone: site.phone.display,
  email: site.email,
  image: site.url + '/og-image.jpg',
  description: site.description,
  priceRange: 'NOK',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: '0484',
    addressLocality: 'Oslo',
    addressCountry: 'NO',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '10:00',
      closes: '14:00',
    },
  ],
  areaServed: { '@type': 'City', name: 'Oslo' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Bilpleietjenester',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Utvendig bilpleie' }, price: '1190', priceCurrency: 'NOK' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Innvendig dyprens' }, price: '2490', priceCurrency: 'NOK' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Full bilpleie' }, price: '3490', priceCurrency: 'NOK' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Keramisk coating' }, price: '7990', priceCurrency: 'NOK' },
    ],
  },
});

const miniSizes = sizeClasses.slice(0, 3);
const miniRows = ['utvendig-bilpleie', 'innvendig-dyprens', 'full-bilpleie'];
const miniNames = Object.fromEntries(services.map((s) => [s.slug, s.name]));

const workSteps = [
  { image: images.foam, alt: imageAlt.foam, label: 'Forberedelse', note: 'Aktivt skum' },
  { image: images.wash, alt: imageAlt.wash, label: 'Vask', note: 'Håndvask, klut for klut' },
  { image: images.ppf, alt: imageAlt.ppf, label: 'Behandling', note: 'Film, coating, polering' },
  { image: images.paint, alt: imageAlt.paint, label: 'Resultat', note: 'Ferdig lakk' },
];
---

<Base
  title="VANTA Auto Care — bilpleie, polering og coating i Oslo"
  description={site.description}
  jsonLd={jsonLd}
>
  <!-- ============ HERO — kinematisk, redaksjonell ============ -->
  <section class="relative flex min-h-[92svh] items-end overflow-hidden bg-ink">
    <Image
      src={images.hero}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      alt={imageAlt.hero}
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/35 to-ink/15"
      aria-hidden="true"
    ></div>

    <div class="wrap relative z-10 w-full pb-14 pt-36">
      <div class="grid items-end gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
        <div>
          <p class="micro micro--dark">Bilpleie i Oslo — Nydalen</p>
          <h1 class="display-hero mt-5 text-paper">
            Detaljert arbeid<span class="text-copper-soft">.</span>
            <br />
            <span class="ml-[0.5ch]">Synlig forskjell<span class="text-copper-soft">.</span></span>
          </h1>
          <p class="mt-7 max-w-lg text-[15px] leading-relaxed text-paper/75">
            VANTA er et uavhengig bilpleieverksted i Oslo. Vask, rens, polering
            og beskyttelse — utført for hånd, med en pris du kjenner før vi
            begynner.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={withBase("/bestill-time")} class="btn-primary-dark">Bestill time</a>
            <a href={`${withBase("/bestill-time")}#overslag`} class="btn-secondary-dark">
              Få et prisoverslag
            </a>
          </div>
          <p class="mt-8 flex flex-wrap gap-x-6 gap-y-1.5 text-xs text-paper/70 lg:hidden">
            <span>{site.address.street}, {site.address.postal}</span>
            <span>Man–fre 08.00–17.00</span>
            <a href={site.phone.href} class="font-semibold text-paper transition-colors hover:text-copper-soft">
              {site.phone.display}
            </a>
          </p>
        </div>

        <dl class="hidden border border-paper/25 bg-ink/40 p-7 backdrop-blur-sm lg:block">
          <div class="grid grid-cols-[110px_1fr] gap-4 border-b border-paper/15 py-2.5 text-sm">
            <dt class="micro micro--dark">Adresse</dt>
            <dd class="text-paper/85">
              {site.address.street}, {site.address.postal}
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-b border-paper/15 py-2.5 text-sm">
            <dt class="micro micro--dark">Tider</dt>
            <dd class="text-paper/85">Man–fre 08.00–17.00 · Lør 10.00–14.00</dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-b border-paper/15 py-2.5 text-sm">
            <dt class="micro micro--dark">Telefon</dt>
            <dd>
              <a href={site.phone.href} class="text-paper/85 transition-colors hover:text-copper-soft">
                {site.phone.display}
              </a>
            </dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 py-2.5 text-sm">
            <dt class="micro micro--dark">Svar</dt>
            <dd class="text-paper/85">Innen én arbeidsdag</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ TJENESTER — spesifikasjons-liste ============ -->
  <section class="wrap py-14 sm:py-20">
    <div class="mb-7 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="micro">Tjenester</p>
        <h2 class="display-xl mt-3">Det vi gjør — og hva det koster</h2>
      </div>
      <a href={withBase("/tjenester")} class="link-plain lg:mb-2">Se alle tjenester</a>
    </div>
    <ServiceIndex items={services} />
  </section>

  <!-- ============ VERKSTED-BÅND — full bredde ============ -->
  <section class="relative h-[32vh] min-h-[240px] overflow-hidden sm:h-[40vh]">
    <Image
      src={images.foam}
      widths={[640, 1024, 1600]}
      sizes="100vw"
      alt={imageAlt.foam}
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-transparent to-transparent" aria-hidden="true"></div>
    <p class="wrap absolute inset-x-0 bottom-5 z-10 micro micro--dark">
      Forberedelse — aktivt skum løsner smuss før håndvask
    </p>
  </section>

  <!-- ============ VEILEDNING — hva trenger bilen din? ============ -->
  <section class="bg-concrete">
    <div class="wrap py-16 sm:py-20">
      <div class="mb-10 max-w-2xl">
        <p class="micro">Veiledning</p>
        <h2 class="display-xl mt-3">Hva trenger bilen din?</h2>
        <p class="mt-4 text-sm leading-relaxed text-steel">
          Velg det som beskriver bilen din best — vi foreslår riktig behandling
          med pris og tidspunkt.
        </p>
      </div>
      <CarGuide />
    </div>
  </section>

  <!-- ============ FØR / ETTER — signatur ============ -->
  <section id="for-etter" class="scroll-mt-16 bg-ink py-20 sm:py-28">
    <div class="wrap mb-10 max-w-2xl">
      <p class="label-rule label-rule--dark">Resultater</p>
      <h2 class="display-xl mt-4 text-paper">Eksempel på resultat</h2>
      <p class="mt-4 text-sm leading-relaxed text-paper/60">
        Lakkrens og polering fjerner oksidering og lette riper. Dra i håndtaket
        for å sammenligne.
      </p>
    </div>
    <BeforeAfter />
  </section>

  <!-- ============ LAKK OG BESKYTTELSE — redaksjonell spredning ============ -->
  <section class="wrap py-20 sm:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-0">
      <figure class="crop-mark relative lg:col-span-7">
        <div class="overflow-hidden">
          <Image
            src={images.paint}
            widths={[640, 1024, 1600]}
            sizes="(max-width: 1024px) 100vw, 58vw"
            alt={imageAlt.paint}
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-3 text-[11px] uppercase tracking-[0.18em] text-steel">
          Polert lakk — eksempelfoto
        </figcaption>
      </figure>

      <div class="lg:col-span-5 lg:pl-16">
        <p class="micro">Lakk og beskyttelse</p>
        <h2 class="display-xl mt-4">Polering og coating skjer innendørs</h2>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-steel">
          Under kontrollert lys, med måling før behandling. Det er forskjellen
          på en lakk som ser fin ut i solnedgang — og en lakk som faktisk er
          jevn.
        </p>
        <dl class="mt-8 max-w-md">
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">Utførelse</dt>
            <dd class="text-ink">For hånd, innendørs, under kontrollert belysning</dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">Kontinuitet</dt>
            <dd class="text-ink">Én person følger bilen fra start til slutt</dd>
          </div>
          <div class="grid grid-cols-[110px_1fr] gap-4 border-t border-line py-3 text-sm">
            <dt class="micro">Pris</dt>
            <dd class="text-ink">Vurdering og fast pris før arbeidet starter</dd>
          </div>
          <p class="border-b border-line" aria-hidden="true"></p>
        </dl>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href={`${withBase("/tjenester")}#keramisk-coating`} class="btn-primary">Om coating</a>
          <a href={withBase("/om-oss")} class="link-plain">Om oss</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRISER — tett ============ -->
  <section class="border-y border-line bg-concrete">
    <div class="wrap py-12 sm:py-14">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="micro">Priser</p>
          <h2 class="display-xl mt-3">Prisen avhenger av bilen</h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-steel">
            Vask og rens prises etter bilstørrelse. Polering, coating og PPF
            vurderes alltid før vi setter pris — du godkjenner før vi begynner.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-5">
            <a href={withBase("/priser")} class="btn-primary">Se full prisliste</a>
            <a href={`${withBase("/bestill-time")}#overslag`} class="link-plain">Få et prisoverslag</a>
          </div>
          <p class="mt-6 max-w-md text-xs leading-relaxed text-steel">
            {priceDisclaimer}
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <caption class="sr-only">Eksempelpriser i kroner per bilstørrelse</caption>
            <thead>
              <tr class="border-b border-line text-left">
                <th scope="col" class="pb-2.5 pr-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-steel">
                  Tjeneste
                </th>
                {miniSizes.map((s) => (
                  <th scope="col" class="pb-2.5 pr-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-steel">
                    {s}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {miniRows.map((slug) => (
                <tr class="border-b border-line">
                  <th scope="row" class="py-3 pr-3 font-medium text-ink">
                    {miniNames[slug]}
                  </th>
                  {(sizePrices[slug] ?? []).slice(0, 3).map((p) => (
                    <td class="py-3 pr-3 font-display text-lg tabular">{p} kr</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-xs text-steel">
            Eksempelpriser i kroner. Full oversikt — med varebil — finner du på
            <a href={withBase("/priser")} class="underline underline-offset-2 transition-colors hover:text-copper">prissiden</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROSESS — arbeid i bilder ============ -->
  <section class="py-16 sm:py-24">
    <div class="wrap mb-9 max-w-2xl">
      <p class="micro">Slik jobber vi</p>
      <h2 class="display-xl mt-3">Fra skum til ferdig lakk</h2>
    </div>
    <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-4">
      {
        workSteps.map((w) => (
          <figure class="relative aspect-square overflow-hidden">
            <Image
              src={w.image}
              widths={[320, 640, 1024]}
              sizes="(max-width: 640px) 50vw, 25vw"
              alt={w.alt}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-ink/70 px-3 py-2.5 backdrop-blur-[2px]">
              <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-soft">
                {w.label}
              </span>
              <span class="block text-xs text-paper/75">{w.note}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ============ PROSJEKTER — kuratert ============ -->
  <section class="wrap pb-20 sm:pb-28">
    <div class="mb-9 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="micro">Prosjekter</p>
        <h2 class="display-xl mt-3">Eksempler fra verkstedet</h2>
      </div>
      <a href={withBase("/prosjekter")} class="link-plain lg:mb-2">Se prosjekter</a>
    </div>

    <div class="grid gap-6 lg:grid-cols-12">
      <figure class="lg:col-span-5">
        <div class="overflow-hidden">
          <Image
            src={images.interior}
            widths={[640, 1024]}
            sizes="(max-width: 1024px) 100vw, 42vw"
            alt={imageAlt.interior}
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-2.5 flex items-baseline justify-between text-sm">
          <span class="font-medium">Innvendig behandling</span>
          <span class="text-xs text-steel">Eksempelfoto</span>
        </figcaption>
      </figure>
      <figure class="lg:col-span-7">
        <div class="overflow-hidden">
          <Image
            src={images.wash}
            widths={[640, 1024, 1600]}
            sizes="(max-width: 1024px) 100vw, 58vw"
            alt={imageAlt.wash}
            class="aspect-[16/10] w-full object-cover"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-2.5 flex items-baseline justify-between text-sm">
          <span class="font-medium">Håndvask og utvendig behandling</span>
          <span class="text-xs text-steel">Eksempelfoto</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ LOKASJON ============ -->
  <MapsBlock />

  <!-- ============ SISTE CTA ============ -->
  <section class="bg-ink">
    <div class="wrap flex flex-col gap-8 py-14 sm:py-16 lg:flex-row lg:items-center lg:justify-between">
      <h2 class="display-xl max-w-2xl text-paper">
        Klar til å se hva bilen din trenger?
      </h2>
      <div class="flex flex-wrap items-center gap-6">
        <a href={withBase("/bestill-time")} class="btn-primary-dark">Bestill time</a>
        <a href={site.phone.href} class="link-plain-dark">
          {site.phone.display}
        </a>
      </div>
    </div>
  </section>
</Base>
