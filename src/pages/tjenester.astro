---
import { withBase } from '../utils/links';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { categories, services, demoPricingNote } from '../data/site';
import { images, imageAlt } from '../data/images';
import { Check } from '@lucide/astro';

const catImage: Record<string, { key: 'wash' | 'interior' | 'paint' | 'ppf'; note: string }> = {
  utvendig: { key: 'wash', note: 'Håndvask — eksempelfoto' },
  innvendig: { key: 'interior', note: 'Kupe — eksempelfoto' },
  lakk: { key: 'paint', note: 'Polert lakk — eksempelfoto' },
  beskyttelse: { key: 'ppf', note: 'PPF-montering — eksempelfoto' },
};

const flagships = ['keramisk-coating', 'ppf'];
---

<Base
  title="Tjenester — bilpleie, polering, coating og PPF i Oslo | VANTA Auto Care"
  description="Utvendig bilpleie, innvendig dyprens, maskinpolering, lakkorrigering, keramisk coating, lakforsegling, felgrens og PPF i Oslo. Se hva som inngår, startpris og varighet for hver behandling."
>
  <section class="wrap py-14 sm:py-20">
    <p class="micro">Tjenester</p>
    <h1 class="h-display mt-4 max-w-3xl">Behandlinger vi utfører</h1>
    <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-steel">
      Katalogen er delt i fire kategorier: utvendig, innvendig, lakk og
      beskyttelse. Åpne en behandling for å se hva som inngår, hvem den passer
      for, pris og varighet.
    </p>
  </section>

  <nav
    class="wrap -mt-5 flex gap-9 overflow-x-auto border-b border-line pb-4"
    aria-label="Kategorier"
  >
    {
      categories.map((c) => (
        <a
          href={`#cat-${c.id}`}
          class="micro shrink-0 transition-colors hover:text-copper"
        >
          {c.label}
        </a>
      ))
    }
  </nav>

  <!-- ============ KATEGORI-KAPITLER ============ -->
  {
    categories.map((c) => {
      const items = services.filter((s) => s.category === c.id);
      const lead = catImage[c.id];
      return (
        <section id={`cat-${c.id}`} class="scroll-mt-16">
          <figure class="relative h-[30vh] min-h-[220px] overflow-hidden sm:h-[40vh]">
            <Image
              src={images[lead.key]}
              widths={[640, 1024, 1600]}
              sizes="100vw"
              alt={imageAlt[lead.key]}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent" aria-hidden="true"></div>
            <figcaption class="wrap absolute inset-x-0 bottom-6 z-10">
              <p class="micro micro--dark">{c.desc}</p>
              <h2 class="display-xl mt-1 text-paper">{c.label}</h2>
            </figcaption>
          </figure>

          <div class="wrap py-10 sm:py-12">
            {
              items.map((s) => (
                <details id={s.slug} class="svc-row" open={flagships.includes(s.slug)}>
                  <summary>
                    <span class="font-display text-[1.5rem] font-semibold leading-tight sm:text-[1.7rem]">
                      {s.name}
                    </span>
                    <span class="svc-meta">
                      <span class="micro hidden sm:inline">{s.duration}</span>
                      <span class="font-display text-[1.35rem] font-semibold tabular">
                        {s.priceFrom}
                      </span>
                      <span class="svc-ind" aria-hidden="true"></span>
                    </span>
                  </summary>

                  <div class="svc-body">
                    <div class="grid gap-8 lg:grid-cols-12">
                      <div class="lg:col-span-5">
                        <p class="text-[15px] leading-relaxed text-ink">{s.description}</p>
                        <p class="mt-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-steel">
                          Passer for
                        </p>
                        <p class="mt-2 text-sm leading-relaxed text-steel">{s.suitedFor}</p>
                      </div>
                      <div class="lg:col-span-7">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-steel">
                          Hva som inngår
                        </p>
                        <ul class="mt-3 grid gap-x-10 gap-y-2.5 sm:grid-cols-2">
                          {s.includes.map((inc) => (
                            <li class="flex items-start gap-2.5 text-sm text-ink">
                              <Check class="mt-0.5 h-4 w-4 shrink-0 text-copper" aria-hidden="true" />
                              {inc}
                            </li>
                          ))}
                        </ul>
                        <div class="mt-7 flex flex-wrap items-center gap-5">
                          {s.booking === 'direct' ? (
                            <a href={`/bestill-time?tjeneste=${s.slug}`} class="btn-primary">
                              Bestill time
                            </a>
                          ) : (
                            <a href={`${withBase("/bestill-time")}#overslag`} class="btn-primary">
                              Få et prisoverslag
                            </a>
                          )}
                          <a href={withBase("/priser")} class="link-plain">Se priser</a>
                        </div>
                      </div>
                    </div>
                  </div>
                </details>
              ))
            }
            <p class="border-b border-line" aria-hidden="true"></p>
          </div>
        </section>
      );
    })
  }

  <!-- ============ AVSLUTTENDE CTA ============ -->
  <section class="border-t border-line bg-ink">
    <div class="wrap flex flex-col gap-8 py-14 sm:py-16 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="display-xl text-paper">Usikker på hva bilen trenger?</h2>
        <p class="mt-3 text-[15px] leading-relaxed text-paper/65">
          Send oss en forespørsel med bil og ønsket resultat. Vi vurderer bilen
          og svarer med et konkret forslag — uten forpliktelser.
        </p>
      </div>
      <a href={`${withBase("/bestill-time")}#overslag`} class="btn-primary-dark shrink-0">
        Send en forespørsel
      </a>
    </div>
  </section>

  <p class="wrap py-8 text-xs text-steel/70">{demoPricingNote}</p>
</Base>
