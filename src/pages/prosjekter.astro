---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { images, imageAlt } from '../data/images';

const work = [
  {
    image: images.paint,
    alt: imageAlt.paint,
    title: 'Lakkrens og polering',
    note: 'Eksempelfoto — lakk etter polering',
    cls: 'aspect-[16/9]',
    span: 'lg:col-span-12',
  },
  {
    image: images.wash,
    alt: imageAlt.wash,
    title: 'Utvendig bilpleie',
    note: 'Eksempelfoto — håndvask',
    cls: 'aspect-[16/10]',
    span: 'lg:col-span-7',
  },
  {
    image: images.interior,
    alt: imageAlt.interior,
    title: 'Innvendig dyprens',
    note: 'Eksempelfoto — kupe',
    cls: 'aspect-[4/5]',
    span: 'lg:col-span-5',
  },
  {
    image: images.ppf,
    alt: imageAlt.ppf,
    title: 'PPF — lakkbeskyttelse',
    note: 'Eksempelfoto — montering av film',
    cls: 'aspect-[4/3]',
    span: 'lg:col-span-5',
  },
  {
    image: images.road,
    alt: imageAlt.road,
    title: 'Lakk og finish',
    note: 'Eksempelfoto — ferdig resultat',
    cls: 'aspect-[16/10]',
    span: 'lg:col-span-7',
  },
  {
    image: images.wheel,
    alt: imageAlt.wheel,
    title: 'Felg og dekk',
    note: 'Eksempelfoto — felg',
    cls: 'aspect-[4/3]',
    span: 'lg:col-span-6',
  },
  {
    image: images.foam,
    alt: imageAlt.foam,
    title: 'Vask og skum',
    note: 'Eksempelfoto — aktivt skum',
    cls: 'aspect-[4/3]',
    span: 'lg:col-span-6',
  },
];
---

<Base
  title="Prosjekter — eksempler på bilpleiearbeid | VANTA Auto Care"
  description="Eksempler på bilpleiearbeid fra verkstedet i Oslo: polering, keramisk coating, utvendig vask, innvendig rens og PPF. Alle bilder er eksempelfoto."
>
  <section class="wrap py-16 sm:py-24">
    <p class="label-rule">Prosjekter</p>
    <h1 class="h-display mt-4 max-w-3xl text-[clamp(2.4rem,5.5vw,4rem)]">
      Eksempler fra verkstedet
    </h1>
    <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-steel">
      Vi viser typen arbeid vi utfører — lakk, kupe, felger og ferdige
      resultater. Alle bilder er eksempelfoto, ikke ekte kundebiler.
    </p>
  </section>

  <section class="wrap pb-20 sm:pb-28">
    <div class="grid gap-x-6 gap-y-10 lg:grid-cols-12">
      {
        work.map((w) => (
          <figure class={w.span}>
            <div class="overflow-hidden">
              <Image
                src={w.image}
                widths={[640, 1024, 1600]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 55vw"
                alt={w.alt}
                class:list={['w-full object-cover', w.cls]}
                loading="lazy"
              />
            </div>
            <figcaption class="mt-3 flex items-baseline justify-between gap-4">
              <span class="font-medium text-ink">{w.title}</span>
              <span class="text-right text-xs text-steel">{w.note}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-14 border-t border-line pt-8">
      <p class="max-w-2xl text-sm leading-relaxed text-steel">
        Se et før/etter-eksempel på <a href="/#for-etter" class="underline underline-offset-2 transition-colors hover:text-copper">forsiden</a>,
        eller send oss en forespørsel med bilder av bilen din — så vurderer vi
        hva den trenger.
      </p>
      <a href="/bestill-time#overslag" class="btn-primary mt-6">Send en forespørsel</a>
    </div>
  </section>
</Base>
