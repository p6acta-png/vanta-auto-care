---
import { withBase } from '../utils/links';
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import { site } from '../data/site';
import { Phone } from '@lucide/astro';
---

<Base
  title="Bestill time eller få prisoverslag | VANTA Auto Care"
  description="Bestill bilpleie i Oslo direkte, eller send en forespørsel og få et konkret prisoverslag for polering, keramisk coating eller PPF."
>
  <section class="wrap py-16 sm:py-24">
    <p class="label-rule">Bestilling</p>
    <h1 class="h-display mt-4 max-w-3xl text-[clamp(2.4rem,5.5vw,4rem)]">
      Bestill time — eller få et prisoverslag
    </h1>
    <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-steel">
      Enkle behandlinger bestilles direkte med fast pris. Polering, coating og
      PPF starter med en vurdering av bilen — da får du et konkret forslag
      før noe settes i gang.
    </p>
  </section>

  <!-- ============ TO VEIER ============ -->
  <section class="wrap pb-16 sm:pb-20">
    <div class="grid gap-x-14 lg:grid-cols-2">
      <div class="border-t border-line py-6">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper">
          Vei 1 — bestill direkte
        </p>
        <h2 class="h-lede mt-3">Fast pris og bekreftet tidspunkt</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-steel">
          Utvendig bilpleie, innvendig dyprens, full bilpleie, lakforsegling
          og felgrens kan bestilles direkte. Velg behandling, dato og
          tidspunkt — så bekrefter vi innen én arbeidsdag.
        </p>
      </div>
      <div class="border-t border-line py-6">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper">
          Vei 2 — prisoverslag
        </p>
        <h2 class="h-lede mt-3">Vurdering før pris</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-steel">
          Lakkrens og polering, lakkorrigering, keramisk coating og PPF prises
          etter bilens tilstand. Send detaljer og bilder — vi vurderer bilen
          og svarer med et konkret forslag.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ SKJEMA + SIDEBAR ============ -->
  <section class="border-t border-line bg-paper-2/60">
    <div class="wrap grid gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div>
        <p class="label-rule">Slik går det til</p>
        <h2 class="h-section mt-3">Fra forespørsel til ferdig bil</h2>
        <ol class="mt-9">
          <li class="grid grid-cols-[48px_1fr] gap-4 border-t border-line py-4">
            <span class="font-display text-2xl font-semibold leading-none text-copper">01</span>
            <p class="text-sm leading-relaxed text-steel">
              <span class="font-semibold text-ink">Send forespørsel.</span>
              Fyll ut skjemaet med bil og ønsket behandling. Ta gjerne bilder
              av lakken.
            </p>
          </li>
          <li class="grid grid-cols-[48px_1fr] gap-4 border-t border-line py-4">
            <span class="font-display text-2xl font-semibold leading-none text-copper">02</span>
            <p class="text-sm leading-relaxed text-steel">
              <span class="font-semibold text-ink">Vi vurderer bilen.</span>
              For polering, coating og PPF ser vi alltid på bilen før vi lover
              noe — vanligvis én arbeidsdag.
            </p>
          </li>
          <li class="grid grid-cols-[48px_1fr] gap-4 border-t border-line py-4">
            <span class="font-display text-2xl font-semibold leading-none text-copper">03</span>
            <p class="text-sm leading-relaxed text-steel">
              <span class="font-semibold text-ink">Du får pris og tidspunkt.</span>
              Konkret pris og foreslått tidspunkt. Ingenting settes i gang før
              du har godkjent.
            </p>
          </li>
          <li class="grid grid-cols-[48px_1fr] gap-4 border-t border-line py-4">
            <span class="font-display text-2xl font-semibold leading-none text-copper">04</span>
            <p class="text-sm leading-relaxed text-steel">
              <span class="font-semibold text-ink">Bilen leveres ferdig.</span>
              Vi går gjennom resultatet sammen før du kjører.
            </p>
          </li>
          <p class="border-b border-line" aria-hidden="true"></p>
        </ol>
        <div class="mt-8 flex flex-wrap items-center gap-4 text-sm">
          <span class="text-steel">Trenger du svar raskt?</span>
          <a
            href={site.phone.href}
            class="inline-flex items-center gap-2 font-semibold text-ink transition-colors hover:text-copper"
          >
            <Phone class="h-4 w-4 text-copper" aria-hidden="true" />
            {site.phone.display}
          </a>
        </div>
      </div>

      <BookingForm />
    </div>
  </section>

  <!-- ============ BUNN ============ -->
  <section class="bg-ink">
    <div class="wrap flex flex-col gap-6 py-14 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-[15px] leading-relaxed text-paper/75">
        Lurer du på hvilken behandling bilen din trenger? Les gjennom
        <a href={withBase("/tjenester")} class="mx-1 font-semibold text-paper underline underline-offset-4 hover:text-copper">tjenestene</a>
        eller spør oss på telefon.
      </p>
      <a href={withBase("/faq")} class="link-plain-dark shrink-0">Vanlige spørsmål</a>
    </div>
  </section>
</Base>
